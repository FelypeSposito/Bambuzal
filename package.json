{
  "name": "bambuzal",
  "version": "0.2.0",
  "description": "Bambuzal — voz, chat de texto e compartilhamento de tela para o seu grupo",
  "main": "main.js",
  "author": "Sposito",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "livekit-client": "^2.5.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.sposito.bambuzal",
    "productName": "Bambuzal",
    "publish": [
      {
        "provider": "github",
        "owner": "FelypeSposito",
        "repo": "Bambuzal"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Bambuzal"
    },
    "files": [
      "main.js",
      "renderer/**/*",
      "package.json"
    ]
  }
}
