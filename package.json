{
  "name": "voicechat-app",
  "version": "0.1.0",
  "description": "App de voz, chat de texto e compartilhamento de tela (estilo Discord) para Windows",
  "main": "main.js",
  "author": "Sposito",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "livekit-client": "^2.5.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.sposito.voicechatapp",
    "productName": "VoiceChatApp",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ]
  }
}
