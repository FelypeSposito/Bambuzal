# Copie este arquivo para ".env" e preencha com os dados do seu
# projeto LiveKit Cloud (painel em https://cloud.livekit.io).
#
# Este arquivo (.env.example) pode ir para o Git. O ".env" NÃO —
# ele está no .gitignore e deve continuar lá.

LIVEKIT_URL=wss://SEU-PROJETO.livekit.cloud
LIVEKIT_API_KEY=coloque-sua-api-key-aqui
LIVEKIT_API_SECRET=coloque-seu-api-secret-aqui

# Senha compartilhada para entrar nas salas.
# Sem ela o endpoint /token fica aberto: qualquer um que descubra a URL
# gera um token e entra. Obrigatória se o servidor estiver na internet.
ROOM_PASSWORD=escolha-uma-senha

# Porta local. Na Render isso é definido automaticamente pela plataforma.
PORT=3001
